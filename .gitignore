# ESP-IDF build output
build/
build-*/
managed_components/

# sdkconfig is generated from sdkconfig.defaults on first build.
#
# It is NOT committed because it is machine-generated and 95 KB of noise. The
# active sdkconfig controls an existing build; defaults seed a new configuration.
# A defaults-only change is not applied to an existing sdkconfig.
# When changing an option, update both files and verify build/config/sdkconfig.h.
sdkconfig
sdkconfig.old
CMakeUserPresets.json

# Editor / tooling
.vscode/
.unix/
__pycache__/
*.pyc

# Build and monitor logs
*.log

# Local backups of superseded source
main_backup_*/

# Test artefacts
test_results.txt
wifi_crash.txt
crash.log
crash2.log

# Large local photos, not part of the project
IMG_*.png
small_IMG_*.png

# Compiled simulator binary
sim/*.exe
sim/*.o
sim/*.obj
release/
site/firmware/
site/dist/
site/node_modules/
site/node.exe
site/npm-tool/
site/.npm-cache/
site/*.tgz

