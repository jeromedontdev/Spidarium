# ESP32-S3 WROOM-1-N16R8 (16MB flash, 8MB octal PSRAM), 240 MHz
# Modeled on Waveshare's tested 02_lvgl_demo_v9 sdkconfig (IDF 5.4) — trimmed.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 8MB octal PSRAM @ 80MHz; instructions + rodata from PSRAM to free internal SRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Prefer PSRAM for eligible network buffers; hardware-required buffers remain
# internal. Pause the display and stop/deinit the radio on every job exit.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Reserve internal RAM for capability-specific allocations, not ordinary malloc.
# This does not prevent the radio from consuming internal DMA memory.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# WiFi: fewer static RX buffers. The defaults (10 static + 32 dynamic) are sized
# for a throughput-heavy application; this device sends almost nothing, so the
# static pool is pure internal-RAM cost.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# LVGL 9.6 does not match the adapter's draw-thread patch hook. The main LVGL
# task uses the supported stack_in_psram API instead.
# CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_RX_BA_WIN=6

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000

# SD save backups use long filenames; allocate workspace on the heap, not stack.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# LVGL 9 (software renderer)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SYSMON=y

# The spider is drawn into a single canvas, so the canvas widget and the
# RGB565A8 format (colour plane + 8-bit alpha) are both required. Without
# LV_USE_CANVAS the renderer does not compile; without RGB565A8 the canvas has
# no alpha channel and the spider sits in an opaque black box.
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_COLOR_DEPTH_UNSET=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=y

# LV_USE_MATRIX stays OFF. It is not needed: the canvas scales coordinates
# itself, and the widget renderer that needed it is gone.
# CONFIG_LV_USE_MATRIX is not set

# Console: UART0 is the primary transport and USB Serial/JTAG the secondary, so
# log output reaches both. The serial test console reads the USB-JTAG driver
# directly (see main/test_console.c) -- fgets() on stdin does not work on this
# board because the console VFS does not route stdin to that transport.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
# Asset pipeline: mmap'd QOI sprites via esp_lv_fs + esp_lv_decoder
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y

# Debug
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=2
