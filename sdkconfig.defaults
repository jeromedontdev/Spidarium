# ESP32-S3 WROOM-1-N16R8 (16MB flash, 8MB octal PSRAM), 240 MHz
# Modeled on Waveshare's tested 02_lvgl_demo_v9 sdkconfig (IDF 5.4) — trimmed.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 8MB octal PSRAM @ 80MHz; instructions + rodata from PSRAM to free internal SRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Allocate WiFi and LWIP buffers in PSRAM, not internal RAM.
#
# This is the fix for the display corruption when WiFi starts. The radio's
# RX/TX pools are large and were being taken from internal RAM, which is the
# same pool the LCD SPI driver needs for its DMA buffers. With WiFi running,
# every frame logged "Draw bitmap failed: ESP_ERR_NO_MEM" and the screen became
# unreadable.
#
# Pausing the game did not help, because the allocation is permanent -- the
# internal RAM is gone for as long as WiFi is up, whether or not the game is
# ticking. Moving the buffers to PSRAM frees that internal RAM permanently.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# WiFi needs a large chunk of INTERNAL RAM for its static RX/TX buffers, and the
# LCD SPI driver needs internal DMA-capable buffers at the same time. With the
# default reserve the SPI driver lost the race and every frame logged
# "Draw bitmap failed: ESP_ERR_NO_MEM". Raising the reserve keeps a floor of
# internal RAM that WiFi cannot take, so the display always has DMA memory.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# WiFi: fewer static RX buffers. The defaults (10 static + 32 dynamic) are sized
# for a throughput-heavy application; this device sends almost nothing, so the
# static pool is pure internal-RAM cost.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000

# LVGL 9 (software renderer)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SYSMON=y

# The spider is drawn into a single canvas, so the canvas widget and the
# RGB565A8 format (colour plane + 8-bit alpha) are both required. Without
# LV_USE_CANVAS the renderer does not compile; without RGB565A8 the canvas has
# no alpha channel and the spider sits in an opaque black box.
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=y

# LV_USE_MATRIX stays OFF. It is not needed: the canvas scales coordinates
# itself, and the widget renderer that needed it is gone.
# CONFIG_LV_USE_MATRIX is not set

# Console: UART0 is the primary transport and USB Serial/JTAG the secondary, so
# log output reaches both. The serial test console reads the USB-JTAG driver
# directly (see main/test_console.c) -- fgets() on stdin does not work on this
# board because the console VFS does not route stdin to that transport.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
# Asset pipeline: mmap'd QOI sprites via esp_lv_fs + esp_lv_decoder
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y

# Debug
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=2
